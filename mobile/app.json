{
  "expo": {
    "name": "MaQuincaillerie",
    "slug": "quincaflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "quincaflow",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#134e8e"
    },
    "android": {
      "package": "tg.quincaflow.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": ["android.permission.INTERNET"]
    },
    "ios": {
      "bundleIdentifier": "tg.quincaflow.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MaQuincaillerie accède à vos photos pour joindre le reçu d’une dépense.",
          "cameraPermission": "MaQuincaillerie utilise l’appareil photo pour prendre le reçu d’une dépense."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withPermissionsMinimales"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
