# Chaîne de connexion Neon Serverless Postgres.
# Créez un projet sur neon.tech puis exécutez schema.sql dans son éditeur SQL.
DATABASE_URL=postgres://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Clé de signature des jetons de session. Obligatoire : sans elle l'application
# refuse de démarrer plutôt que de signer avec une valeur par défaut connue.
# Générez-la avec : openssl rand -base64 48
JWT_SECRET=

# ─────────────────────────── Après le déploiement ───────────────────────────
# Ces deux variables suffisent. Elles se renseignent dans le tableau de bord de
# l'hébergeur, jamais dans le dépôt : .env.local est ignoré par git.
#
# À l'ouverture d'un environnement neuf, exécuter schema.sql dans la base avant
# le premier démarrage. Le fichier est idempotent (CREATE TABLE IF NOT EXISTS),
# on peut donc le rejouer pour appliquer les tables ajoutées depuis.
