{
  "name": "quincaflow",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"mobile/{app,src}/**/*.{ts,tsx}\" \"mobile/*.{js,json}\" *.mjs *.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"mobile/{app,src}/**/*.{ts,tsx}\" \"mobile/*.{js,json}\" *.mjs *.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:check": "node scripts/db.mjs check",
    "db:apply": "node scripts/db.mjs apply"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@zxing/browser": "^0.2.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.8",
    "lucide-react": "^0.456.0",
    "next": "^15.0.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.9"
  }
}
